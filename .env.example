# .env — your secret credentials
# Copy this file to .env and fill in your values
# NEVER share this file or commit it to GitHub

# Get this from @BotFather on Telegram when you create your bot
BOT_TOKEN=your_bot_token_here

# Your family group chat ID — add @userinfobot to your group to find it
# It will look like:  -1001234567890  (negative number for groups)
CHAT_ID=your_chat_id_here
